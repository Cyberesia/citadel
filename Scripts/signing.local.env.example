# Local signing configuration — NOT committed to git.
#
# Setup:
#   cp Scripts/signing.local.env.example Scripts/signing.local.env
#   # Edit TEAM_ID (10-character Apple Developer Team ID)
#   ./Scripts/prepare-signing.sh
#
# Find your Team ID: Xcode → Settings → Accounts → select team → Team ID
# Or: security find-identity -v -p codesigning

TEAM_ID=YOUR_TEAM_ID

# Optional — skip keychain lookup in packaging scripts:
# CODESIGN_IDENTITY="Developer ID Application: Your Organization (YOUR_TEAM_ID)"

# Optional — local notarytool keychain profile name (see RELEASE.md):
# NOTARYTOOL_PROFILE=citadel-notary
